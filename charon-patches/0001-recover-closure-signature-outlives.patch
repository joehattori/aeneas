+    /// Add the outlives relations between the closure signature regions that the closure body
+    /// requires. Rustc erases most of these regions, and `push_param_env_without_parents` turns
+    /// them into unrelated region parameters of the closure.
+    fn push_closure_sig_outlives(&mut self, span: Span, def: &hax::FullDef<'tcx>) {
+        if self.t_ctx.options.mir_level < MirLevel::Promoted {
+            // Borrow-checking would steal the built MIR that we translate.
+            return;
+        }
+        let Some(closure) = def.def_id().real_rust_def_id().as_local() else {
+            return;
+        };
+        let Some(rels) = crate::closure_outlives::closure_sig_outlives(self.t_ctx.tcx, closure)
+        else {
+            return;
+        };
+        if rels.is_empty() {
+            return;
+        }
+        // The same signature as `hax::Closure::sig`, whose erased regions are placeholders.
+        let args = def.this().rustc_args(self.hax_state_with_id());
+        let sig = hax::closure_sig(self.t_ctx.tcx, args.as_closure());
+        let regions = crate::closure_outlives::sig_regions(sig.skip_binder());
+        let translate = |this: &mut Self, i: usize| -> Option<RegionId> {
+            use crate::hax::SInto;
+            let region: hax::Region =
+                regions.get(i).copied().flatten()?.sinto(this.hax_state_with_id());
+            match this.translate_region(span, &region).ok()? {
+                Region::Var(DeBruijnVar::Bound(dbid, rid)) if dbid == DeBruijnId::zero() => {
+                    Some(rid)
+                }
+                _ => None,
+            }
+        };
+        for (a, b) in rels {
+            let (Some(ra), Some(rb)) = (translate(self, a), translate(self, b)) else {
+                continue;
+            };
+            if ra == rb {
+                continue;
+            }
+            let pred = RegionBinder::empty(OutlivesPred(
+                Region::Var(DeBruijnVar::new_at_zero(ra)),
+                Region::Var(DeBruijnVar::new_at_zero(rb)),
+            ));
+            let params = &mut self.the_only_binder_mut().params;
+            if !params.regions_outlive.contains(&pred) {
+                params.regions_outlive.push(pred);
+            }
+        }
+    }
+
     /// Push a new binding level, run the provided function inside it, then return the bound value.
     pub(crate) fn inside_binder<F, U>(
         &mut self,
